#!/usr/bin/expect -f
# Real operator path, NOT a test-binary bypass of installed-file identity.
# Every response is sent only after its corresponding real PTY prompt.
set timeout 90
log_user 1
set env(NO_COLOR) 1
set env(STL_NO_CLEAR) 1
spawn /usr/local/bin/stl menu
expect {
  -re {Choose a task:} { send -- "1\r" }
  timeout { puts stderr "IPSEC_MENU_E2E=MAIN_MENU_TIMEOUT"; exit 20 }
}
expect {
  -re {Tunnel type \[1\]:} { send -- "5\r" }
  timeout { puts stderr "IPSEC_MENU_E2E=CREATE_SELECTION_TIMEOUT"; exit 21 }
}
expect {
  -re {Choose a type:} { send -- "5\r" }
  timeout { puts stderr "IPSEC_MENU_E2E=IPSEC_SELECTION_TIMEOUT"; exit 22 }
}
expect {
  -re {Type PREPARE to prepare selected prerequisites} { send -- "PREPARE\r" }
  timeout { puts stderr "IPSEC_MENU_E2E=PREPARE_GATE_TIMEOUT"; exit 23 }
}
expect {
  -re {Selected prerequisites verified; continuing the same tunnel Create} {
    puts "IPSEC_MANAGED_SINGLE_PREPARE=PASS"
  }
  timeout { puts stderr "IPSEC_MENU_E2E=PREPARE_NOT_VERIFIED"; exit 24 }
}
expect {
  -re {Other server's reachable IPv4 address} { send -- "q\r" }
  timeout { puts stderr "IPSEC_MENU_E2E=PRIVATE_SERVICE_NOT_READY"; exit 25 }
}
expect {
  -re {Create cancelled} { puts "IPSEC_SEPARATE_LINK_CREATE_NOT_APPLIED=PASS" }
  timeout { puts stderr "IPSEC_MENU_E2E=CREATE_CANCEL_TIMEOUT"; exit 26 }
}
expect {
  eof {}
  timeout { puts stderr "IPSEC_MENU_E2E=UNEXPECTED_RUNNING_MENU"; exit 27 }
}
catch wait result
if {[llength $result] < 4 || [lindex $result 3] != 0} {
  puts stderr "IPSEC_MENU_E2E=NONZERO_EXIT"
  exit 28
}
puts "IPSEC_MANAGED_REAL_ROOT_TTY=PASS"
