#!/usr/bin/expect -f
# Disposable systemd guest only. A genuine vendor VPN must survive every
# foreign/ambiguous host conflict, even when an operator pastes STOP.
set timeout 200
log_user 1
set env(NO_COLOR) 1
set env(STL_NO_CLEAR) 1
spawn /usr/local/bin/stl menu
expect {
  -re {Choose a task:} { send -- "1\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=MAIN_TIMEOUT"; exit 20 }
}
expect {
  -re {Tunnel type \[1\]:} { send -- "5\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=CREATE_TIMEOUT"; exit 21 }
}
expect {
  -re {Choose a type:} { send -- "5\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=IPSEC_TIMEOUT"; exit 22 }
}
expect {
  -re {Type PREPARE to prepare selected prerequisites} { send -- "PREPARE\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=PREPARE_TIMEOUT"; exit 23 }
}
# An adversarial already-installed package fixture must first pass local
# dpkg --verify and then fail specifically at the signed archive boundary.
# Merely rejecting it due to corrupted dpkg metadata would be false proof.
if {$env(STL_IPSEC_PREPARE_CASE) eq "existing_vendor_local_metadata_forgery"} {
  expect {
    -re {official[[:space:]]+provenance} {
      puts "IPSEC_FORGED_INSTALLED_DPKG_REJECTED_BY_SIGNED_ARCHIVE=PASS"
    }
    timeout { puts stderr "IPSEC_FORGED_DPKG=NO_SIGNED_ARCHIVE_REJECTION"; exit 33 }
  }
}
expect {
  -re {Service action \(Enter cancels\):} {
    # One case becomes unsafe AFTER preview, but BEFORE the final STOP
    # authorization is reattested under the installed maintenance lock.
    if {$env(STL_IPSEC_PREPARE_CASE) eq "existing_vendor_late_config"} {
      exec /bin/mkdir -p /etc/swanctl/conf.d
      exec /usr/bin/touch /etc/swanctl/conf.d/stl-test-foreign-after-preview.conf
    }
    send -- "STOP strongswan.service\r"
  }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=SERVICE_MENU_TIMEOUT"; exit 24 }
}
expect {
  -re {No eligible exact-unit STOP/DISABLE consent was provided} {
    puts "IPSEC_FOREIGN_HOST_PREVIEW_STOP_DENIED=PASS"
  }
  -re {Service transition was refused or incomplete} {
    puts "IPSEC_FOREIGN_HOST_REATTESTED_BEFORE_STOP=PASS"
  }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=SERVICE_CHANGED_OR_STOP_WAS_NOT_DENIED"; exit 25 }
}
expect {
  -re {Private IPsec admission remains blocked} {
    puts "IPSEC_FOREIGN_HOST_PRIVATE_PROVISION_DENIED=PASS"
  }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=PRIVATE_SERVICE_PROVISIONED"; exit 26 }
}
expect {
  -re {Press Enter to continue} { send -- "\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=NO_ACK"; exit 27 }
}
# Rejected Create returns to its own tunnel choices, not directly to
# the top-level menu. A negative case must leave both levels normally.
expect {
  -re {Tunnel type \[1\]:} { send -- "0\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=NO_CREATE_BACK"; exit 28 }
}
# The outer Create command has one final acknowledgement after the
# Create submenu returns to its caller; do not confuse it with a hang.
expect {
  -re {Press Enter to continue} { send -- "\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=NO_FINAL_ACK"; exit 29 }
}
expect {
  -re {Choose a task:} { send -- "8\r" }
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=NO_EXIT"; exit 30 }
}
expect {
  eof {}
  timeout { puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=STILL_RUNNING"; exit 31 }
}
catch wait result
if {[llength $result] < 4 || [lindex $result 3] != 0} {
  puts stderr "IPSEC_FOREIGN_STOP_NEGATIVE=NONZERO_EXIT"
  exit 32
}
puts "IPSEC_REAL_PREEXISTING_VENDOR_LEFT_ACTIVE_AND_ENABLED=PASS"
